function isNullOrEmpty(obj) 
{
    if (obj === null || obj === undefined) {
        return true;
    }

    if (typeof obj === "string") {
        return obj.trim().length === 0;
    }

    try {
        var str = JSON.stringify(obj);
        if (str === "{}" || str === "[]" || str === "") {
            return true;
        }
    } 
    catch (e) {}

    try {
        for (var key in obj) {
            return false;
        }
    } 
    catch (e2) {}

    
    try {
        if (obj.isEmpty && obj.isEmpty()) return true;  // Java Map/Collection
        if (obj.size && obj.size() === 0) return true;  // Java List/Set
    } 
    catch (e3) {}

    return false;
}

function doesUserOwnItemAlready(userItemsProxy)
{
    var getUserItemsResult = userItemsProxy.getUserItemsPage({}, true);

    if (getUserItemsResult.status === 200 &&
        getUserItemsResult.data.results.count > 0)
    {
        var userItems = getUserItemsResult.data.results.items;

        for (var i = 0; i < userItems.length; ++i)
        {
            if (userItems[i].defId === data.toyId)
            {
                return userItems[i];
            }
        }
    }

    return null;
}
