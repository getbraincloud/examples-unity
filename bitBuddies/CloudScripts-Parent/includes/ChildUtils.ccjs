function updateBuddyLevel(profileId, amountToIncrease, childAppId, identityProxy, playerStatProxy, playerStateProxy)
{
  var response = {};
  var buddyLeveledUp = false;
  var buddyLeveledUpTo5 = false;
  // switch to profile
  var switchToChildResult = identityProxy.switchToChildProfile(profileId, childAppId, false);
  if(switchToChildResult)
  {
    if(!isNullOrEmpty(switchToChildResult.data) && !isNullOrEmpty(switchToChildResult.data.experienceLevel))
    {
      var currentLevel = switchToChildResult.data.experienceLevel;
      var currentLevelUpReq = 0;
      var statProxy = bridge.getPlayerStatisticsServiceProxy();

      //Getting next XP level for Client UI purposes incase user levels up
      var getNextLevelResult = playerStatProxy.getNextExperienceLevel();
      if(getNextLevelResult.status === 200 && getNextLevelResult.data &&
        getNextLevelResult.data.xp_level && getNextLevelResult.data.xp_level.experience)
      {
        currentLevelUpReq = getNextLevelResult.data.xp_level.experience;
      }

      //Check if we leveled up, if so send back next XP requirement to user
      //for the level progress bar.
      var increaseXpResult = statProxy.incrementExperiencePoints(amountToIncrease);
      if(!isNullOrEmpty(increaseXpResult.data))
      {
        var responseLevel = increaseXpResult.data.experienceLevel;
        var experiencePoints = increaseXpResult.data.experiencePoints;
        if(responseLevel > currentLevel)
        {
          buddyLeveledUp = true;

          if(increaseXpResult.data.rewards && increaseXpResult.data.rewards.experienceLevels)
          {
            var xpLevelArray = increaseXpResult.data.rewards.experienceLevels;
            for(var i=0; i<xpLevelArray.length;i++)
            {
              if(xpLevelArray[i] === 5)
              {
                buddyLeveledUpTo5 = true;
                response.didCatchLevel5 = true;
              }
            }
          }
        
          var previousLevelUpReq = currentLevelUpReq;
          var getNextLevelResult = playerStatProxy.getNextExperienceLevel();
          if(getNextLevelResult.status === 200)
          {
            if(getNextLevelResult.data.xp_level.experience)
            {
              response.nextLevelUpXP = getNextLevelResult.data.xp_level.experience;
            }
            
            response.previousLevelUpReq = previousLevelUpReq;
            
            var summaryFriendData = switchToChildResult.data.summaryFriendData;
            summaryFriendData.nextLevelUpXP = response.nextLevelUpXP;
            summaryFriendData.level = responseLevel;
            summaryFriendData.experiencePoints = experiencePoints;
            summaryFriendData.previousLevelXP = previousLevelUpReq;
            playerStateProxy.updateSummaryFriendData(summaryFriendData);
          }
        }
        else
        {
          //If we didn't level up, update the XP
          var summaryFriendData = switchToChildResult.data.summaryFriendData;
          summaryFriendData.experiencePoints = experiencePoints;
          summaryFriendData.nextLevelUpXP = currentLevelUpReq;
          playerStateProxy.updateSummaryFriendData(summaryFriendData);
        }
        response.increaseXpResult = increaseXpResult.data;
      }
    }
    else
    {
      response.switchToChildError = switchToChildResult;
    }
    
    response.buddyLeveledUp = buddyLeveledUp;
    response.didCatchLevel5 = buddyLeveledUpTo5;
    // .return to parent
    identityProxy.switchToParentProfile(MASTER_PARENT_NAME);

    if(buddyLeveledUp)
    {
      //if child leveled up, increment stat
      var statData = {"buddiesLeveledUp": 1};
      var incrementStatResult = playerStatProxy.incrementUserStats(statData);
      

      if(buddyLeveledUpTo5)
      {
        var statLevelData = {"level5Buddies": 1};
        var incrementBuddyLevelStatResult = playerStatProxy.incrementUserStats(statLevelData);
        response.incrementBuddyLevelStatResult = incrementBuddyLevelStatResult;
      }
      else
      {
        response.incrementStatResult = incrementStatResult;
      }
    }
  }
  return response;
}

// view "boxRarity" global entity
function addChildAndCreateBuddyFromBox(boxType, childAppId)
{
  var response = {};
  
  // Get identity proxy for profile switching
  var identityProxy = bridge.getIdentityServiceProxy();
  var boxRarity = null;
  var rarityTypes = null;
  var selectedRarity = null;
  var selectedStats = {};

  var globalEntityProy = bridge.getGlobalEntityServiceProxy();
  const where = {entityType:"config"};
  const orderBy = {createdAt:1};
  var listOfConfigs = globalEntityProy.getList(where,orderBy,10 ).data.entityList;

  for (var i = 0; i < listOfConfigs.length; ++i)
  {
    if (listOfConfigs[i].entityIndexedId == BOX_RARITY)
    {
      boxRarity = listOfConfigs[i].data;
    }

    if (listOfConfigs[i].entityIndexedId == RARITY_TYPES)
    {
      rarityTypes = listOfConfigs[i].data;
    }
  }

  // Switch to Child app profile using helper
  // Uses childAppId from input data
  const switched = addChildAccount(childAppId, identityProxy);

  if (switched) {
    if (boxRarity && boxRarity[boxType]) {
      var rarities = boxRarity[boxType];
      // Build weighted array for random selection
      var weighted = [];
      for (var rarity in rarities) {
        for (var i = 0; i < rarities[rarity]; i++) {
          weighted.push(rarity);
        }
      }
      if (weighted.length > 0) {
        var idx = Math.floor(Math.random() * weighted.length);
        selectedRarity = weighted[idx];
        if (rarityTypes && rarityTypes[selectedRarity]) {
          selectedStats = rarityTypes[selectedRarity];
        }
      }
    }

    //create data and assign stats & rarity to it to send later
    var newBuddy = selectedStats;
    newBuddy.rarity = selectedRarity;
    newBuddy.level = 1;
    newBuddy.experiencePoints = 0;
    newBuddy.lastIdleTimestamp = Date.now(); 

    //get next experience requirement to save to new buddy
    var playerStatProxy = bridge.getPlayerStatisticsServiceProxy();
    var getNextLevel = playerStatProxy.getNextExperienceLevel();
    if(getNextLevel)
    {
      //bridge.logInfoJson("get next level up", {"data": getNextLevel.data.xp_level});
      newBuddy.nextLevelUpXP = getNextLevel.data.xp_level.experience;
    }

    var entityProxy = bridge.getEntityServiceProxy();
    entityProxy.updateSingleton(CHILD_BUDDY_ENTITY_TYPE, newBuddy, {"acl": 2}, -1);
    var playerProxy = bridge.getPlayerStateServiceProxy();
    playerProxy.updateSummaryFriendData(newBuddy);



    //Switch back to parent profile for cleanup
    identityProxy.switchToParentProfile(MASTER_PARENT_NAME);
    var statToIncrement = {"bitBuddiesOwned":1};
    var playerStatisticsProxy = bridge.getPlayerStatisticsServiceProxy();
    newBuddy.statIncreaseResult = playerStatisticsProxy.incrementUserStats(statToIncrement);
  }

  response = getChildProfiles(identityProxy).data;
  response.newBuddy = newBuddy;
  
  return response;
}

function getChildStats(childAppId, profileId)
{
  var response = {};
  var identityProxy = bridge.getIdentityServiceProxy();
  switchToChildAccount(profileId, childAppId,identityProxy);
  if(switchToChildAccount)
  {
    var playerStatProxy = bridge.getPlayerStatisticsServiceProxy();
    var getStatsResult = playerStatProxy.readAllUserStats();
    if(getStatsResult.status === 200)
    {
      response = getStatsResult.data;
    }
    //identityProxy.switchToParentProfile(MASTER_PARENT_NAME);
  }
  return response;
}

