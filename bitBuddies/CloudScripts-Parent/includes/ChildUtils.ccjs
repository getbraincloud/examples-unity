const MASTER_PARENT_NAME = "Master";
const BUDDY_CONFIG_TYPE = "buddyConfigs";
const BUDDY_INDEX_ID = "buddyTypes";
const BUDDY_CONFIG_ENTITY_ID = "26220884-f447-4e87-a47e-e155358d599a";
const PARENT_GEMS = "GEMS";
const BUDDY_BLING = "buddyBling";
const CHILD_BUDDY_ENTITY_TYPE = "buddies";
const LOOTBOX_CHANCES_TYPE = "buddyBoxChances";
const LOOTBOX_CHANCES_ENTITY_ID = "f15c3e03-d7bb-464b-ae94-7e70d233a6d7";

const BOX_RARITY = "boxRarity";
const RARITY_TYPES = "rarityTypes";

function getChildProfiles(identityProxy)
{
    var switchResponse = identityProxy.getChildProfiles(true);
    return switchResponse;
}

function addChildAccount(appId, identityProxy)
{
    //Switch to child app
    //The profileId of the child profile to switch to. If null and forceCreate is true a new profile will be created.
    //params: profileID, appID, forceCreate
    var switchResponse = identityProxy.switchToChildProfile(null, appId, true);

    return switchResponse;
}

function syncSummaryData()
{
  var playerProxy = bridge.getPlayerStateServiceProxy();
  playerProxy.updateUserName("test");

  // read buddy info
  playerProxy.updateSummaryFriendData({"name": "updateName"});
}

function switchToChildAccount(profileId, appId, identityProxy)
{
    //Switch to child app
    var switchResponse = identityProxy.switchToChildProfile(profileId, appId, false);
    
    // it was succesful
    return switchResponse.status == 200;
}

function switchToChildAppSafely(appId, identityProxy) 
{
    //Switch to child app
    var switchResponse = identityProxy.switchToSingletonChildProfile(appId, false);
    
    if (switchResponse.status != 200)
    {
        switch (switchResponse.reason_code)
        {
            // must force create
            case 40208:
                {
                    // no error to report, just a parent - child relationship hasn't been created yet
                    switchResponse = identityProxy.switchToSingletonChildProfile(appId, true);
                }break;
            //Run state is disabled.
            case 40372:
                {
                    // DO NOTHING, ITS DISABLED
                    // the script calling this, if its being looked up by team/ group access should be removed from that access.
                    
                }
                break;
            default:
                {
                    bridge.logInfoJson(appId + " - switchToChildSafely Un Handled" + switchResponse.reason_code, switchResponse);
                }break;
        }
    }
    
    // it was succesful
    return switchResponse.status == 200;
}

function extractBalances(data)
{
  var flatBalances = {};

  // Handle parentCurrency (nested groups)
  for (var group in data.parentCurrency) {
    if (data.parentCurrency.hasOwnProperty(group)) {
      var currencies = data.parentCurrency[group];
      for (var currency in currencies) {
        if (currencies.hasOwnProperty(currency)) {
          
          flatBalances[currency] = {
          balance : data.parentCurrency[group][currency].balance, 
          consumed : data.parentCurrency[group][currency].consumed,
        };
        }
      }
    }
  }

  // Handle currencyMap (flat structure)
  for (var currency in data.currencyMap) {
    if (data.currencyMap.hasOwnProperty(currency)) {
      flatBalances[currency] = {
          balance : data.currencyMap[currency].balance, 
          consumed : data.currencyMap[currency].consumed,
        };
    }
  }

  return flatBalances;
}

