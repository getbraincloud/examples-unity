"use strict";


function main() {

  var storeId = data.storeId;

  var itemCatalogProxy = bridge.getItemCatalogServiceProxy();
  var userItemsProxy   = bridge.getUserItemsServiceProxy();
  var appStoreProxy    = bridge.getAppStoreServiceProxy();

  // ── 1. Fetch ALL item catalog entries (paginated), keep only purchasable ones ──
  var allCatalogItems = [];
  var pageOffset = 0;
  var hasMore = true;

  while (hasMore) {
    var catalogContext = {
      "pagination":    { "rowsPerPage": 50, "pageNumber": pageOffset + 1 },
      "searchCriteria": {},
      "sortCriteria":  {}
    };

    var catalogResult = itemCatalogProxy.getCatalogItemsPage(catalogContext);

    if (catalogResult.status !== 200) {
      return {
        "error":  "Failed to fetch item catalog",
        "status": catalogResult.status,
        "page":   pageOffset
      };
    }

    var pageItems = catalogResult.data.results.items || [];
    for (var i = 0; i < pageItems.length; i++) {
      var item = pageItems[i];
      // Only include items that have at least one buyPrice entry
      var buyPrice = item.buyPrice;
      var isPurchasable = false;
      if (buyPrice) {
        var keys = Object.keys(buyPrice);
        if (keys.length > 0) {
          isPurchasable = true;
        }
      }
      if (isPurchasable) {
        allCatalogItems.push(item);
      }
    }

    hasMore = catalogResult.data.results.moreAfter === true;
    pageOffset++;
  }

  // ── 1b. Fetch eligible promotions ─────────────────────────────────────────
  var promotions = [];
  var promoResult = appStoreProxy.getEligiblePromotions();

  if (promoResult.status === 200) {
    promotions = promoResult.data.promotions || [];
  }

  // Build a lookup map: defId -> promotional buyPrice
  // Each promotion has an "items" object keyed by defId, e.g.:
  //   "items": {
  //       "bundle_stars_200": {
  //           "defId": "bundle_stars_200",
  //           "buyPrice": { "Coins": 10 }
  //       }
  //   }
  var promoPriceMap = {};
  for (var p = 0; p < promotions.length; p++) {
    var promo = promotions[p];
    if (promo.items) {
      var promoDefIds = Object.keys(promo.items);
      for (var d = 0; d < promoDefIds.length; d++) {
        var defId = promoDefIds[d];
        var promoItem = promo.items[defId];
        if (promoItem.buyPrice) {
          // If multiple promotions target the same item, last one wins
          promoPriceMap[defId] = promoItem.buyPrice;
        }
      }
    }
  }

  // ── 1c. Apply promotional pricing to catalog items ────────────────────────
  for (var j = 0; j < allCatalogItems.length; j++) {
    var catalogItem = allCatalogItems[j];
    var originalBuyPrice = JSON.parse(JSON.stringify(catalogItem.buyPrice));

    if (promoPriceMap[catalogItem.defId]) {
      // This item has an active promotion — override buyPrice
      var promoBuyPrice = JSON.parse(JSON.stringify(promoPriceMap[catalogItem.defId]));
      promoBuyPrice.isPromotion = true;
      catalogItem.buyPrice = promoBuyPrice;
      catalogItem.defaultBuyPrice = originalBuyPrice;
    } else {
      // No active promotion for this item
      catalogItem.buyPrice.isPromotion = false;
      catalogItem.defaultBuyPrice = originalBuyPrice;
    }
  }

  // ── 2. Fetch user-owned Freebie items by specific defIds ──────────────────
  var freebiesContext = {
    "pagination": { "rowsPerPage": 50, "pageNumber": 1 },
    "searchCriteria": {
      "defId": { "$in": ["Freebie_Coins", "Freebie_Gems", "Freebie_Stars"] }
    },
    "sortCriteria": {}
  };

  var freebiesResult = userItemsProxy.getUserItemsPage(freebiesContext, true);

  if (freebiesResult.status !== 200) {
    return {
      "error":  "Failed to fetch user freebie items",
      "status": freebiesResult.status
    };
  }

  var freebieItems = freebiesResult.data.results.items || [];

  // ── 3. Fetch store products for the requested store ───────────────────────
  var priceInfoCriteria = {
    "userCurrency": "CAD"
  };

  var storeProducts = [];

  if(storeId != ""){
    var storeResult = appStoreProxy.getSalesInventory(storeId, priceInfoCriteria);

    if (storeResult.status !== 200) {
      return {
        "error":   "Failed to fetch store inventory",
        "status":  storeResult.status,
        "storeId": storeId
      };
    }

    storeProducts = storeResult.data.productInventory || [];
  }

  // ── Return all results ────────────────────────────────────────────────────
  return {
    "catalogItems":      allCatalogItems,
    "catalogItemCount":  allCatalogItems.length,
    "promotions":        promotions,
    "promotionCount":    promotions.length,
    "freebies":          freebieItems,
    "freebiesCount":     freebieItems.length,
    "storeProducts":     storeProducts,
    "storeProductCount": storeProducts.length
  };
}

main();
