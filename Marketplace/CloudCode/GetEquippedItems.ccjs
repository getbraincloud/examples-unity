"use strict";
// GetEquippedItem (VSCode created Script) 
// returns the equipped item id in the specified item slot

function main() {
  var response = {};

  bridge.logDebugJson("Script Inputs", data);

  //data.itemSlot - gets the item equipped in this itemSlot if it exists
  var entityService = bridge.getEntityServiceProxy();
  var entityType = "EquippedItems";
  var existingEntity = entityService.getEntitiesByType(entityType);

  response.error = false;
  if(existingEntity.status !== 200){
    response.error = true;
    response.message = "Failed to retrieve equipped items for the player.";
    return response;
  }
  
  if(existingEntity.data.entities.length > 0){
    var entityData = existingEntity.data.entities[0].data;
    var equippedItemId = entityData[data.itemSlot];

    response.equippedItems = entityData;
  }else{
    response.error = true;
    response.message = "No equipped items found for the player.";
  }

  return response;
}

main();
