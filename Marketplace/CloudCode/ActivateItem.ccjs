"use strict";
// ActivateItem - Uses/activates an item the user already owns

var XP_GENERATOR_STATUS_NAME = "xp_generator";

function main() {
  var response = {};

  bridge.logDebugJson("Script Inputs", data);

  var userItemsService = bridge.getUserItemsServiceProxy();

  var useItem = userItemsService.useUserItem(data.itemId, -1, { "used": true }, true);

  if (useItem.status !== 200) {
    response.error = true;
    response.message = "Failed to use item";
    response.errorMessage = useItem.statusMessage;
    return response;
  }

  response.error = false;
  response.used = useItem.data.used;

  if (useItem.data.statusEffects) {
    response.activeUntil = useItem.data.statusEffects.activeUntil;

    // The xp_generator status is native brainCloud item-catalog state, which brainCloud
    // stops returning once it naturally expires. CollectXpGeneratorXP.ccjs needs the
    // activation window to still be known after that point (e.g. the user was offline
    // past the full 90s), so persist it ourselves as the source of truth for collection.
    if (useItem.data.statusEffects.statusName === XP_GENERATOR_STATUS_NAME) {
      var playerStateService = bridge.getPlayerStateServiceProxy();
      var activeStart = useItem.data.statusEffects.activeStart || Date.now();

      playerStateService.updateAttributes({
        "xpGenActiveUntil":     String(useItem.data.statusEffects.activeUntil),
        "xpGenLastCollectedAt": String(activeStart)
      }, false);
    }
  }

  return response;
}

main();
