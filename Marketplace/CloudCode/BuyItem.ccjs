"use strict";
// BuyItem (VSCode created Script) 

function main() {
  var response = {};

  bridge.logDebugJson("Script Inputs", data);

  var userItemsService = bridge.getUserItemsServiceProxy();
  var purchaseItem = userItemsService.purchaseUserItem(data.defId, 1, "", true);

   if(purchaseItem.status !== 200){
    response.error = true;
    response.message = "Failed to purchase item";
    response.errorData = purchaseItem;

    return response;
  }

  //lets get the user item id that we just purchased
  var items = purchaseItem.data.items;

  var itemId = null;
  var itemObj = null;

  for (var key in items) {
      if (items.hasOwnProperty(key)) {
          itemId = key;        // "d9e50f3b-cabb-4adc-8811-9ca97aac6570"
          itemObj = items[key]; // full item object not necessary for this but maybe for the future
          break; // assuming only one item
      }
  }
  
  response.currencySpent = purchaseItem.data.currencySpent;
  response.gainedItem = itemObj;
  response.success = true;

  return response;
}

main();
