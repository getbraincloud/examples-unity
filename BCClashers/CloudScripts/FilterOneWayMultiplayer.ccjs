"use strict";

// One-way (raid) matchmaking filter. brainCloud runs this once per candidate from
// FindPlayersUsingFilter(); return true to keep the candidate, false to drop them.
// Attach under Design | Multiplayer | Matchmaking.
//
//   matchCandidate.summaryFriendData - { hasDefense, defenderRank }, published by the client
//   extraParms                       - { requireDefense, defenderRank }, rank -1 = any

let RANK_NONE = 3;  // ArmyDivisionRank.None
let RANK_ANY = -1;

function main() {
    let summary = (data.matchCandidate || {}).summaryFriendData || {};
    let extraParms = data.extraParms || {};

    // No summaryFriendData means a profile from before this filter shipped, so it has no base to raid.
    let defenderRank = typeof summary.defenderRank === "number" ? summary.defenderRank : RANK_NONE;
    let hasDefense = summary.hasDefense === true && defenderRank !== RANK_NONE;

    if (extraParms.requireDefense !== false && !hasDefense) {
        return false;
    }

    let wantedRank = typeof extraParms.defenderRank === "number" ? extraParms.defenderRank : RANK_ANY;
    return wantedRank === RANK_ANY || defenderRank === wantedRank;
}

main();

